{
	"info": {
	  "name": "Coupon Uses API",
	  "_postman_id": "c12345-uses-collection",
	  "description": "API requests to test coupon_uses routes",
	  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
	  {
		"name": "Create Coupon Use",
		"request": {
		  "method": "POST",
		  "header": [
			{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
		  ],
		  "body": {
			"mode": "raw",
			"raw": "{\n  \"coupon_id\": 1,\n  \"user_id\": 2,\n  \"order_id\": 5\n}"
		  },
		  "url": {
			"raw": "{{baseURL}}/coupon-uses",
			"host": ["{{baseURL}}"],
			"path": ["coupon-uses"]
		  }
		}
	  },
	  {
		"name": "Get All Coupon Uses (Admin)",
		"request": {
		  "method": "GET",
		  "header": [
			{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
		  ],
		  "url": {
			"raw": "{{baseURL}}/coupon-uses",
			"host": ["{{baseURL}}"],
			"path": ["coupon-uses"]
		  }
		}
	  },
	  {
		"name": "Get Coupon Use By ID",
		"request": {
		  "method": "GET",
		  "header": [
			{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
		  ],
		  "url": {
			"raw": "{{baseURL}}/coupon-uses/1",
			"host": ["{{baseURL}}"],
			"path": ["coupon-uses", "1"]
		  }
		}
	  },
	  {
		"name": "Delete Coupon Use (Admin)",
		"request": {
		  "method": "DELETE",
		  "header": [
			{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
		  ],
		  "url": {
			"raw": "{{baseURL}}/coupon-uses/1",
			"host": ["{{baseURL}}"],
			"path": ["coupon-uses", "1"]
		  }
		}
	  }
	]
  }
  